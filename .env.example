# ==============================================================================
# yt-research-gen Environment Configuration
# ==============================================================================

# --- Primary AI Provider: ccsio.ai (OpenAI-Compatible) ---
# For code revision & runtime: only your ccsio.ai API key is required.
# (No Gemini API key is needed for code revision).
AI_PRIMARY_PROVIDER=openai_compatible
AI_FALLBACK_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.ccsio.ai/v1
OPENAI_API_KEY=your_ccsio_ai_api_key_here
OPENAI_MODEL=qwen-3.8

# --- Google Gemini AI (Optional / Unused for Code Revision) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_MODEL_CASCADE=gemini-3.8-flash,gemini-3.6-flash

# --- Request Timeouts & Circuit Breaker ---
AI_REQUEST_TIMEOUT_SECONDS=300.0

# --- Persistent Obsidian Knowledge Vault ---
VAULT_DIR=./vault

